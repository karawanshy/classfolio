# Copy to .env.local and fill in. Both Supabase values are required.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Screenshot provider. `{url}` is replaced with the URL-encoded site address.
# Default (if unset): Microlink, 1280×800 viewport.
# Add &screenshot.fullPage=true for full-page captures, which enables the scrolling "peek" on hover.
VITE_SCREENSHOT_URL_TEMPLATE=https://api.microlink.io/?url={url}&screenshot=true&meta=false&embed=screenshot.url&viewport.width=1280&viewport.height=800
